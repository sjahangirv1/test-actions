{
  "ignorePatterns": [
    {
      "pattern": "^https?://",
      "comment": "Skip external URLs"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": ""
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com"],
      "headers": {
        "Accept": "text/html"
      }
    }
  ],
  "timeout": 5000,
  "retryOn429": true,
  "aliveStatusCodes": [200, 206]
}